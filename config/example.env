# Copy this file to config/local.env and replace every empty value before
# running the create workflows. config/local.env is excluded from Git.

# Prefix used for project-owned resources and CloudFormation stacks.
PROJECT_PREFIX="Acme"

# Security accounts created before the Control Tower Landing Zone.
AUDIT_ACCOUNT_EMAIL=""
LOG_ARCHIVE_ACCOUNT_EMAIL=""

# Account Factory: Network account and initial Identity Center user.
NETWORK_ACCOUNT_EMAIL=""
NETWORK_SSO_EMAIL=""
NETWORK_SSO_FIRST_NAME=""
NETWORK_SSO_LAST_NAME=""

# Account Factory: Shared Services account and initial Identity Center user.
SHARED_SERVICES_ACCOUNT_EMAIL=""
SHARED_SERVICES_SSO_EMAIL=""
SHARED_SERVICES_SSO_FIRST_NAME=""
SHARED_SERVICES_SSO_LAST_NAME=""

# Account Factory: Development account and initial Identity Center user.
DEV_ACCOUNT_EMAIL=""
DEV_SSO_EMAIL=""
DEV_SSO_FIRST_NAME=""
DEV_SSO_LAST_NAME=""

# Account Factory: Production account and initial Identity Center user.
PROD_ACCOUNT_EMAIL=""
PROD_SSO_EMAIL=""
PROD_SSO_FIRST_NAME=""
PROD_SSO_LAST_NAME=""
